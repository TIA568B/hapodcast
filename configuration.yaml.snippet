# ===========================================================================
# OPTIONAL — you do NOT need this file for a normal install.
# ===========================================================================
# Daily Podcast Queue is managed entirely from the UI:
#   Settings -> Devices & services -> Add integration -> "Daily Podcast Queue",
# then use its "Configure" button to add podcasts and set the run time.
#
# This snippet exists only for two optional cases:
#   1. Migrating from an older YAML-based version of this integration.
#   2. You prefer to seed the initial config from YAML. On startup the
#      integration imports this block into a UI config entry ONCE, then ignores
#      the YAML. After the first import you can delete this block and manage
#      everything from the UI.
# ---------------------------------------------------------------------------

# daily_podcasts:
#   player: media_player.office   # your Music Assistant / Sonos office player
#   podcasts:
#     - name: The Daily
#       feed_url: https://feeds.simplecast.com/54nAGcIl
#     - name: Up First
#       feed_url: https://feeds.npr.org/510318/podcast.xml
#   # optional:
#   # timezone: America/New_York

# (Optional) See the integration's INCLUDE/SKIP/QUEUE lines in the logs:
# logger:
#   default: info
#   logs:
#     custom_components.daily_podcasts: info
